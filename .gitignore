# =====================================================================
#  .gitignore for RoR2VRMod (Blowntobytes build)
#  Anything matched here is never committed. Groups, top to bottom:
#  build output, game/reference assemblies, logs & local configs
#  (these can contain your Windows user name and machine paths),
#  secrets, and editor/OS junk.
# =====================================================================

# --- Build output (regenerated by every build) -------------------------
/RoR2VRMod/[Oo]bj/
/RoR2VRMod/[Bb]in/
/VREnabler/[Oo]bj/
/VREnabler/[Bb]in/
/VRAPI/[Oo]bj/
/VRAPI/[Bb]in/
/build/
/out/
/pkg/
/dist/
*.rsp
*.pdb
*.zip
*.7z
*.rar
*.patch
*.bundle

# The patcher needs this manifest at runtime, so it is tracked even though
# the rest of Dependencies/ (copied game files) is ignored.
/VREnabler/Dependencies/*
!/VREnabler/Dependencies/UnitySubsystemsManifest.json

# --- Game files and reference assemblies: copyrighted, never commit ----
# Copies of the game's DLLs (Risk of Rain 2_Data/Managed), BepInEx,
# HookGen output, publicized assemblies and unpacked asset bundles.
/refs/
/libs/
/Libs/
/lib/
/game/
/Managed/
/BepInEx/
/mmhook/
/MMHOOK/
/il/
MMHOOK_*.dll
*.publicized.dll
*-publicized.dll
Assembly-CSharp*.dll
RoR2.dll
Rewired_*.dll
Facepunch*.dll
Wwise*.dll
*.assets
*.resS
# Only the two redistributable OpenXR runtime files in VREnabler/Plugins
# are allowed in the repository; every other DLL is ignored.
*.dll
!/VREnabler/Plugins/openxr_loader.dll
!/VREnabler/Plugins/UnityOpenXR.dll

# --- Logs, crash dumps and local configs -------------------------------
# BepInEx/Unity logs include your Windows user name and folder paths.
*.log
LogOutput*.log
Player*.log
*.dmp
*.crash
# Per-machine BepInEx configs (VRMod.cfg etc.) and r2modman profile exports
*.cfg
*.r2z
*.r2x
/config/
/profiles/

# --- Secrets: never commit tokens, keys or credentials ------------------
# Thunderstore / GitHub API tokens (tcli uses TCLI_AUTH_TOKEN or --token;
# keep them in the environment, never in a file inside the repo).
.env
.env.*
*.env
*.token
*token*.txt
*secret*
*.pem
*.key
*.pfx
*.snk
*credentials*
.netrc
_netrc

# --- Editor, tooling and OS junk ----------------------------------------
/.vs/
/.vscode/
/.idea/
*.user
*.suo
*.swp
*~
/.claude/
/scratch/
Thumbs.db
Desktop.ini
.DS_Store
